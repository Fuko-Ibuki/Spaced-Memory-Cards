          "key": "a",
          "content": [
            {
              "type": "math",
              "latex": "0"
            }
          ]
        },
        {
          "key": "b",
          "content": [
            {
              "type": "math",
              "latex": "1"
            }
          ]
        },
        {
          "key": "c",
          "content": [
            {
              "type": "math",
              "latex": "\\infty"
            }
          ]
        },
        {
          "key": "d",
          "content": [
            {
              "type": "text",
              "text": "不存在"
            }
          ]
        }
      ],
      "answer": {
        "keys": [
          "b"
        ]
      },
      "explanation": [
        {
          "type": "text",
          "text": "这是基本极限，结果为 1。"
        }
      ]
    },
    {
      "id": "media-008",
      "type": "true_false",
      "chapter": "四、易错辨析",
      "tags": [
        "积分",
        "判断"
      ],
      "difficulty": 2,
      "content": [
        {
          "type": "text",
          "text": "因为 "
        },
        {
          "type": "math",
          "latex": "\\int f(x)g(x)dx=\\int f(x)dx\\cdot\\int g(x)dx"
        },
        {
          "type": "text",
          "text": "，所以积分可以直接拆成乘积。"
        }
      ],
      "answer": {
        "value": false
      },
      "explanation": [
        {
          "type": "text",
          "text": "一般不成立。乘积的积分不能拆成两个积分的乘积，需根据被积函数结构使用换元、分部积分等方法。"
        }
      ]
    }
  ]
