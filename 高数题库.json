       "latex": "(1,4]"
      }
     ]
    },
    {
     "key": "b",
     "content": [
      {
       "type": "math",
       "latex": "[1,4]"
      }
     ]
    },
    {
     "key": "c",
     "content": [
      {
       "type": "math",
       "latex": "(1,4)"
      }
     ]
    },
    {
     "key": "d",
     "content": [
      {
       "type": "math",
       "latex": "(-\\infty,4]"
      }
     ]
    }
   ],
   "answer": {
    "keys": [
     "a"
    ]
   },
   "explanation": [
    {
     "type": "math",
