*,*::before,*::after{ box-sizing:border-box; }
html,body{ height:100%; }
body{
  margin:0;
  font-family:var(--font-global);
  -webkit-font-smoothing:antialiased;
  text-rendering:optimizeLegibility;
  overflow-x:hidden;
}
ul,ol{ margin:0; padding:0; list-style:none; }
button{ font-family:var(--font-ui); }
.chev{ display:inline-block; position:relative; top:0; font-family:var(--font-symbol); font-style:normal; font-weight:600; -webkit-text-stroke:.2px currentColor; transform:rotate(90deg); transform-origin:center; }
input,textarea{ font-family:var(--font-body); }
.kbd,.symbol,.icon-symbol,.qcard-type .dot{ font-family:var(--font-symbol); font-style:normal; font-weight:700; -webkit-text-stroke:.35px currentColor; }
.icon-symbol{ display:inline-flex; align-items:center; justify-content:center; line-height:1; }
img,svg{ display:block; max-width:100%; }
a{ color:inherit; }
::selection{ background:var(--accent-glow); }

/* ============================================================
   1. 设计令牌 (Design Tokens)
   ============================================================ */
:root{
  /* -- 深色主题基调（中性深灰纸面） -- */
  --bg:#12161b;
  --bg-elevated:#1a2029;
  --bg-soft:#212832;
  --bg-hover:#2a323d;
  --border:#2e3640;
  --border-soft:#242b34;

  --paper:#20262e;
  --paper-alt:#272e37;
  --paper-line:#414b57;
  --ink:#eef1f3;
  --ink-soft:#b8c0c9;
  --ink-faint:#89939e;
  --surface-lift-1:rgba(255,255,255,.07);
  --surface-lift-2:rgba(255,255,255,.13);

  --text:#eef1f3;
  --text-soft:#a7afb8;
  --text-faint:#707a84;

  --accent:#58c46e;
  --accent-strong:#4bb862;
  --accent-shade:#2f8f45;
  --accent-ink:#ffffff;
  --accent-glow:rgba(88,196,110,.30);
  --ambient-glow:rgba(255,201,60,.16);

  --success:#58c46e;
  --success-bg:rgba(120,224,146,.24);
  --success-strong:#8ff0a4;
  --danger:#ef5b5b;
  --danger-bg:rgba(239,91,91,.22);
  --danger-strong:#ff9494;
  --info:#4fa6e0;
  --info-bg:rgba(79,166,224,.22);
  --info-strong:#8ecbf1;
  --gold:#ffc93c;
  --gold-bg:rgba(255,201,60,.16);
  --gold-ink:#3a2a02;

  --shadow-card:0 20px 60px -15px rgba(0,0,0,.55), 0 2px 8px rgba(0,0,0,.35);
  --shadow-pop:0 10px 30px -8px rgba(0,0,0,.45);
  --shadow-glow:0 0 0 1px rgba(255,201,60,.16), 0 20px 70px -10px rgba(255,201,60,.22);

  --radius-sm:10px;
  --radius-md:16px;
  --radius-lg:26px;
  --radius-pill:999px;

  --ease:cubic-bezier(.22,.9,.32,1);
  --ease-spring:cubic-bezier(.34,1.56,.64,1);
  --dur-fast:.15s;
  --dur:.32s;
  --dur-slow:.5s;

  /* Typography tokens: the global family can switch the UI and authored content together. */
  --font-sans:"SMC HY QiHei Punctuation","SMC HY QiHei","SMC SF Pro",sans-serif;
  --font-serif:"SMC CJK Punctuation","SMC FZ New Book","SMC Minion",serif;
  --font-ui:var(--font-sans);
  --font-content:var(--font-serif);
  --font-global:var(--font-ui);
  --font-display:var(--font-ui);
  --font-body:var(--font-ui);
  --font-num:"SMC Minion",serif;
  --font-symbol:"SMC SF Pro","SF Pro Display","SF Pro Text",sans-serif;
  --font-math:"KaTeX_Main","SMC Minion Math","Minion Math",serif;

  --font-size-ui-xs:11px;
  --font-size-ui-sm:12px;
  --font-size-ui-md:13px;
  --font-size-ui-lg:14.5px;
  --font-size-ui-xl:16px;
  --font-size-content-sm:14px;
  --font-size-content-md:15.5px;
  --font-size-content-lg:22px;
  --font-size-sample:22px;
  --font-weight-thin:300;
  --font-weight-regular:400;
  --font-weight-medium:500;
  --font-weight-semibold:600;
  --font-weight-bold:700;
  --font-weight-heavy:800;
  --font-weight-black:900;
  --color-type-primary:var(--text);
  --color-type-secondary:var(--text-soft);
  --color-type-tertiary:var(--text-faint);
  --color-content-primary:var(--ink);
  --color-content-secondary:var(--ink-soft);
  --emoji-font:"SMC Apple Emoji","Apple Color Emoji","Segoe UI Emoji","Noto Color Emoji",emoji,sans-serif;
  color-scheme:dark;
}
html[data-font-size="small"]{
  --font-size-ui-xs:10px; --font-size-ui-sm:11px; --font-size-ui-md:12px;
  --font-size-ui-lg:13px; --font-size-ui-xl:14.5px;
  --font-size-sample:18px;
}
html[data-font-size="large"]{
  --font-size-ui-xs:12px; --font-size-ui-sm:13.5px; --font-size-ui-md:14.5px;
  --font-size-ui-lg:16px; --font-size-ui-xl:18px;
  --font-size-sample:26px;
}
html[data-font-family="serif"]{
  --font-ui:var(--font-serif);
  --font-content:var(--font-ui); --font-global:var(--font-ui);
  --font-display:var(--font-ui); --font-body:var(--font-ui);
  --font-num:"SMC Minion",serif;
}
html[data-font-family="default"]{
  --font-ui:var(--font-sans);
  --font-content:var(--font-serif); --font-global:var(--font-ui);
  --font-display:var(--font-ui); --font-body:var(--font-ui);
  --font-num:"SMC Minion",serif;
}
html[data-font-family="sans"]{
  --font-ui:var(--font-sans);
  --font-content:var(--font-ui); --font-global:var(--font-ui);
  --font-display:var(--font-ui); --font-body:var(--font-ui);
  --font-num:"SMC SF Pro","SF Pro Display","SF Pro Text",sans-serif;
}

html[data-theme="light"]{
  --bg:#f7f8f2;
  --bg-elevated:#ffffff;
  --bg-soft:#eef2ea;
  --bg-hover:#e2e9dd;
  --border:#dde5d7;
  --border-soft:#e8eee3;

  --paper:#ffffff;
  --paper-alt:#f4f0e6;
  --paper-line:#e6e0cf;
  --ink:#26201a;
  --ink-soft:#6c6250;
  --ink-faint:#9b9078;
  --surface-lift-1:rgba(255,255,255,.5);
  --surface-lift-2:rgba(255,255,255,.75);

  --text:#212b22;
  --text-soft:#57624f;
  --text-faint:#8a9482;

  --accent:#3dae5a;
  --accent-strong:#329a4c;
  --accent-shade:#1f7a38;
  --accent-ink:#ffffff;
  --accent-glow:rgba(61,174,90,.20);
  --ambient-glow:rgba(240,165,0,.12);

  --success:#3dae5a;
  --success-bg:rgba(61,174,90,.12);
  --success-strong:#1f7a38;
  --danger:#e2483f;
  --danger-bg:rgba(226,72,63,.12);
  --danger-strong:#b83128;
  --info:#3f8fd6;
  --info-bg:rgba(63,143,214,.12);
  --info-strong:#2a6ba8;
  --gold:#f0a500;
  --gold-bg:rgba(240,165,0,.14);
  --gold-ink:#3a2a02;

  --shadow-card:0 20px 50px -18px rgba(38,32,20,.22), 0 2px 8px rgba(38,32,20,.10);
  --shadow-pop:0 10px 26px -10px rgba(38,32,20,.18);
  --shadow-glow:0 0 0 1px rgba(240,165,0,.14), 0 16px 50px -12px rgba(240,165,0,.18);
  color-scheme:light;
}

@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{
    animation-duration:.001ms !important;
    animation-iteration-count:1 !important;
    transition-duration:.001ms !important;
    scroll-behavior:auto !important;
  }
}

/* ============================================================
   2. 基础版式
   ============================================================ */
body{
  background:var(--bg);
  color:var(--text);
  transition:background var(--dur) var(--ease),color var(--dur) var(--ease);
}
body::before{
  /* 环境氛围：极淡的暖光晕，呼应"台灯"概念 */
  content:"";
  position:fixed; inset:0;
  background:radial-gradient(ellipse 900px 600px at 50% -8%, var(--ambient-glow), transparent 60%);
  opacity:.5;
  pointer-events:none;
  z-index:0;
}
html[data-theme="light"] body::before{ opacity:.35; }

h1,h2,h3,h4{ margin:0; font-family:var(--font-display); font-weight:var(--font-weight-semibold); letter-spacing:.01em; }
.num{ font-family:var(--font-num); font-style:normal; font-weight:var(--font-weight-medium); }
.streak-num{ font-weight:800; }
.emoji-icon,
.brand .brand-mark,
.streak-pill .flame,
.dropzone .dz-icon,
.deck-info-card .deck-emoji,
.mode-card .mode-icon,
.big-stat .icon,
.empty-state .e-icon,
.toast-icon{
  font-family:var(--emoji-font);
  font-weight:400;
  font-style:normal;
  line-height:1;
  text-rendering:auto;
}
.emoji-icon{ display:inline-block; vertical-align:-.08em; }

:focus-visible{
  outline:2px solid var(--accent);
  outline-offset:3px;
  border-radius:6px;
}
button:focus-visible{ outline-offset:2px; }

/* ============================================================
   3. 应用外壳 / 顶部导航
   ============================================================ */
#app-root{ position:relative; z-index:1; min-height:100vh; display:flex; flex-direction:column; }
html.app-booting #app-root{ visibility:hidden; }

.topnav{
  position:sticky; top:0; z-index:40;
  display:flex; align-items:center; gap:18px;
  padding:14px 22px;
  background:color-mix(in srgb, var(--bg-elevated) 88%, transparent);
  backdrop-filter:blur(14px) saturate(1.2);
  border-bottom:1px solid var(--border-soft);
}
.brand{
  display:flex; align-items:center; gap:10px;
  font-family:var(--font-serif); font-weight:700; font-size:16.5px;
  letter-spacing:.01em;
  color:var(--text);
  white-space:nowrap;
}
.brand .brand-mark{
  display:inline-flex; align-items:center; justify-content:center;
  width:28px;height:28px; border-radius:9px;
  background:linear-gradient(155deg,var(--accent-strong),var(--accent));
  color:var(--accent-ink); font-size:15px;
  transform:rotate(-6deg);
  box-shadow:0 4px 10px -3px rgba(0,0,0,.35);
}
.nav-spacer{ flex:1; }

.streak-pill{
  display:flex; align-items:center; gap:6px;
  padding:6px 12px 6px 9px;
  border-radius:var(--radius-pill);
  background:var(--gold-bg);
  color:var(--gold);
  font-size:13px; font-weight:600;
  line-height:1;
  border:1px solid color-mix(in srgb, var(--gold) 40%, transparent);
  white-space:nowrap;
}
.streak-pill .flame,
.streak-pill .streak-num,
.streak-pill .streak-unit{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  line-height:1;
}
.streak-pill .flame{
  font-size:14px;
  transform:translateY(.5px);
  filter:drop-shadow(0 0 6px color-mix(in srgb, var(--gold) 60%, transparent));
}
.streak-pill.streak-placeholder{
  display:none;
  visibility:hidden;
  pointer-events:none;
}
.streak-pill.bump{ animation:streakBump .5s var(--ease-spring); }
@keyframes streakBump{ 0%{transform:scale(1)} 35%{transform:scale(1.28)} 100%{transform:scale(1)} }

.nav-primary-group{ display:flex; align-items:center; gap:12px; }
.nav-tabs{ display:flex; gap:4px; background:var(--bg-soft); padding:4px; border-radius:var(--radius-pill); border:1px solid var(--border-soft); }
.nav-standalone{ display:flex; align-items:center; }
.nav-standalone-left{ margin-left:0; }
.nav-standalone-right{ display:flex; gap:12px; align-items:center; }
.nav-standalone-btn{ border:1px solid var(--border-soft); background:var(--bg-soft); }
.nav-standalone-btn.active{ background:var(--accent); border-color:var(--accent); color:var(--accent-ink); }
.nav-tab{
  border:none; background:transparent; cursor:pointer;
  padding:7px 16px; border-radius:var(--radius-pill);
  font-size:var(--font-size-ui-lg); font-weight:600; color:var(--text-soft);
  transition:background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
}
.nav-tab:hover{ color:var(--text); }
.nav-tab.active{ background:var(--accent); color:var(--accent-ink); }

.icon-btn{
  width:34px;height:34px; border-radius:50%;
  border:1px solid var(--border-soft); background:var(--bg-soft); color:var(--text-soft);
  display:grid; place-items:center; cursor:pointer; font-size:15px; padding:0; line-height:1;
  transition:transform var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
}
.icon-btn svg{ width:16px; height:16px; display:block; flex:0 0 16px; margin:auto; overflow:visible; }
.icon-btn:hover{ background:var(--bg-hover); color:var(--text); transform:translateY(-1px); }

.typography-panel{ margin-top:16px; }
.settings-panel-heading{ display:flex; align-items:flex-start; justify-content:space-between; gap:16px; }
.settings-panel-heading h3{ margin:0 0 6px; color:var(--text); font-size:var(--font-size-ui-xl); }
.settings-panel-heading p{ margin:0; font-size:var(--font-size-ui-sm); line-height:1.6; }
.settings-panel-symbol{ display:grid; place-items:center; width:38px; height:38px; border-radius:12px; color:var(--accent); background:var(--accent-bg); font-family:var(--font-global); font-style:normal; font-size:var(--font-size-sample); line-height:1; }
.typography-setting{ margin-top:20px; }
.typography-setting + .typography-setting{ padding-top:18px; border-top:1px solid var(--border-soft); }
.typography-setting-label{ display:flex; align-items:baseline; justify-content:space-between; gap:12px; margin-bottom:10px; }
.typography-setting-label b{ font-size:var(--font-size-ui-lg); color:var(--text); }
.typography-setting-label .muted{ font-size:var(--font-size-ui-xs); }
.setting-slider{ display:flex; gap:4px; width:max-content; max-width:100%; padding:4px; border:1px solid var(--border-soft); background:var(--bg-soft); border-radius:var(--radius-pill); }
.setting-slider-option{ min-width:68px; border:0; border-radius:var(--radius-pill); padding:8px 16px; background:transparent; color:var(--text-soft); font:600 var(--font-size-ui-md)/1 var(--font-ui); cursor:pointer; transition:background var(--dur-fast) var(--ease),color var(--dur-fast) var(--ease),transform var(--dur-fast) var(--ease); }
.setting-slider-option:hover{ color:var(--text); }
.setting-slider-option.active{ background:var(--accent); color:var(--accent-ink); box-shadow:0 2px 6px color-mix(in srgb,var(--accent) 28%,transparent); }
.setting-slider[data-setting-slider="fontFamily"] .setting-slider-option[data-value="default"],
.setting-slider[data-setting-slider="fontFamily"] .setting-slider-option[data-value="sans"]{ font-family:var(--font-sans); }
.setting-slider[data-setting-slider="fontFamily"] .setting-slider-option[data-value="serif"]{ font-family:var(--font-serif); }

main#view{ flex:1; display:flex; flex-direction:column; position:relative; z-index:30; background:var(--bg); touch-action:pan-y; }
main#view.view-dragging{ transition:none; will-change:transform, opacity; }
main#view.view-snap{ transition:transform .34s cubic-bezier(.22,1,.36,1), opacity .34s cubic-bezier(.22,1,.36,1); will-change:transform, opacity; }
body.view-swipe-active{ overscroll-behavior-x:contain; }
.view-swipe-preview{
  position:fixed; left:0; right:0; top:60px; bottom:0; z-index:20;
  display:flex; flex-direction:column; overflow:hidden; background:var(--bg);
  pointer-events:none; opacity:0; transform:translate3d(0,0,0);
  will-change:transform, opacity;
}
.view-swipe-preview.view-snap{ transition:opacity .34s cubic-bezier(.22,1,.36,1); }

/* ============================================================
   4. 按钮
   ============================================================ */
.btn{
  position:relative; isolation:isolate;
  display:inline-flex; align-items:center; justify-content:center; gap:8px;
  border-radius:var(--radius-pill);
  border:none;
  padding:12px 22px;
  font-size:14.5px; font-weight:700;
  cursor:pointer;
  transition:transform var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease), opacity var(--dur-fast) var(--ease);
  white-space:nowrap;
  user-select:none;
}
.btn:active:not(:disabled){ transform:translateY(3px); }
.btn:disabled{ opacity:.4; cursor:not-allowed; transform:none; }
.btn-primary{ background:var(--accent); color:var(--accent-ink); box-shadow:0 4px 0 0 var(--accent-shade); }
.btn-primary:hover:not(:disabled){ background:var(--accent-strong); }
.btn-primary:active:not(:disabled){ box-shadow:0 1px 0 0 var(--accent-shade); }
.btn:focus-visible{
  outline:none;
  box-shadow:var(--btn-depth-shadow, none);
}
.btn:focus-visible::before{
  content:""; position:absolute; top:-10px; right:-10px; bottom:calc(-10px - var(--btn-depth, 0px)); left:-10px; z-index:-1;
  border-radius:999px;
  background:var(--focus-mask-bg, color-mix(in srgb, var(--accent) 20%, transparent));
  box-shadow:inset 0 0 0 0 transparent;
  pointer-events:none;
}
.btn-primary{ --btn-depth:4px; --btn-depth-shadow:0 4px 0 0 var(--accent-shade); }
.btn-primary{ --focus-mask-bg:color-mix(in srgb, var(--accent) 24%, transparent); }
.btn-primary:active:not(:disabled){ --btn-depth:1px; --btn-depth-shadow:0 1px 0 0 var(--accent-shade); }
.btn-secondary{ background:var(--bg-soft); color:var(--text); box-shadow:0 4px 0 0 var(--border); }
.btn-secondary:hover:not(:disabled){ background:var(--bg-hover); }
.btn-secondary:active:not(:disabled){ box-shadow:0 1px 0 0 var(--border); }
.btn-secondary{ --btn-depth:4px; --btn-depth-shadow:0 4px 0 0 var(--border); }
.btn-secondary{ --focus-mask-bg:color-mix(in srgb, var(--border) 35%, transparent); }
.btn-secondary:active:not(:disabled){ --btn-depth:1px; --btn-depth-shadow:0 1px 0 0 var(--border); }
.btn-ghost{ background:transparent; color:var(--text-soft); box-shadow:none !important; }
.btn-ghost:hover:not(:disabled){ color:var(--text); background:var(--bg-soft); }
.btn-ghost:active:not(:disabled){ transform:scale(.96); }
.btn-ghost:focus-visible{ box-shadow:none !important; }
.btn-danger{ background:var(--danger-bg); color:var(--danger-strong); box-shadow:0 4px 0 0 color-mix(in srgb, var(--danger) 30%, transparent); }
.btn-danger:hover:not(:disabled){ background:color-mix(in srgb, var(--danger) 22%, transparent); }
.btn-danger:active:not(:disabled){ box-shadow:0 1px 0 0 color-mix(in srgb, var(--danger) 30%, transparent); }
.btn-danger{ --btn-depth:4px; --btn-depth-shadow:0 4px 0 0 color-mix(in srgb, var(--danger) 30%, transparent); }
.btn-danger{ --focus-mask-bg:color-mix(in srgb, var(--danger) 30%, transparent); }
.btn-danger:active:not(:disabled){ --btn-depth:1px; --btn-depth-shadow:0 1px 0 0 color-mix(in srgb, var(--danger) 30%, transparent); }
.btn:active:focus-visible:not(:disabled){
  box-shadow:var(--btn-depth-shadow, none);
}
.btn-block{ width:100%; }
.btn-lg{ padding:16px 28px; font-size:16px; }
.kbd{
  display:inline-flex; align-items:center; justify-content:center;
  min-width:18px; height:18px; padding:0 4px;
  border-radius:5px; font-size:10.5px; font-weight:700;
  background:rgba(0,0,0,.18); color:inherit; opacity:.65;
  font-family:-apple-system,sans-serif;
}
.kbd svg{ width:12px; height:12px; display:block; stroke:currentColor; stroke-width:2.4; fill:none; stroke-linecap:round; stroke-linejoin:round; }
.btn-primary .kbd{ background:rgba(0,0,0,.16); }

/* ============================================================
   5. 通用容器 / 面板
   ============================================================ */
.container{ max-width:880px; margin:0 auto; width:100%; padding:0 20px; }
/* 学习设置的控件布局可横向展开；文本内容仍使用通用 880px 文本流。 */
.setup-container{ max-width:880px; }
.browse-container{ max-width:880px; }
.panel{
  background:var(--bg-elevated);
  border:1px solid var(--border-soft);
  border-radius:var(--radius-lg);
  padding:26px;
}
.section-title{
  font-size:13px; font-weight:700; letter-spacing:.08em; text-transform:uppercase;
  color:var(--text-faint); margin-bottom:14px; display:flex; align-items:center; gap:8px;
}
.section-title .line{ flex:1; height:1px; background:var(--border-soft); }
.muted{ color:var(--text-soft); }
.center-col{ display:flex; flex-direction:column; align-items:center; justify-content:center; flex:1; padding:40px 20px; text-align:center; }

/* ============================================================
   6. 加载 / 拖拽题库
   ============================================================ */
.dropzone{
  width:100%; max-width:640px;
  border:2px dashed var(--border);
  border-radius:var(--radius-lg);
  padding:52px 30px;
  display:flex; flex-direction:column; align-items:center; gap:14px;
  background:var(--bg-elevated);
  transition:border-color var(--dur) var(--ease), background var(--dur) var(--ease), transform var(--dur) var(--ease);
  cursor:pointer;
}
.dropzone:hover{ border-color:var(--accent); }
.dropzone.dragover{
  border-color:var(--accent);
  background:var(--accent-glow);
  transform:scale(1.015);
}
.dropzone .dz-icon{
  width:64px;height:64px; border-radius:var(--radius-md);
  background:linear-gradient(160deg,var(--paper),var(--paper-alt));
  display:flex; align-items:center; justify-content:center;
  font-size:28px; box-shadow:var(--shadow-pop);
  transform:rotate(-4deg);
}
.dropzone h3{ font-size:19px; color:var(--text); }
.dropzone p{ margin:0; color:var(--text-soft); font-size:13.5px; line-height:1.6; }
.dz-hint{ font-size:12px; color:var(--text-faint); margin-top:2px; }
.hidden-input{ position:absolute; width:1px;height:1px; opacity:0; overflow:hidden; }
.format-guide{
  width:100%; max-width:640px; margin-top:14px; padding:16px;
  background:var(--bg-elevated); border:1px solid var(--border-soft); border-radius:var(--radius-lg);
  text-align:left;
}
.format-guide summary{
  list-style:none; display:flex; align-items:center; justify-content:space-between; gap:12px;
  cursor:pointer; user-select:none;
}
.format-guide summary::-webkit-details-marker{ display:none; }
.format-guide summary::after{ content:"▾"; color:var(--text-faint); transition:transform var(--dur-fast) var(--ease); }
.format-guide[open] summary::after{ transform:rotate(180deg); }
.format-guide h4{ font-size:14px; color:var(--text); margin:0; font-family:inherit; }
.format-guide-body{ margin-top:10px; }
.format-guide p{ margin:0 0 10px; color:var(--text-soft); font-size:12.8px; line-height:1.7; }
.format-guide-grid{ display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; }
.format-item{
  border:1px solid var(--border-soft); background:var(--bg-soft); border-radius:var(--radius-md);
  padding:10px 11px; min-width:0;
}
.format-item b{ display:block; color:var(--text); font-size:12.5px; margin-bottom:4px; }
.format-item span{ display:block; color:var(--text-faint); font-size:11.5px; line-height:1.55; overflow-wrap:anywhere; }
.format-guide code{ color:var(--accent); font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace; font-size:.92em; }

.demo-link{
  margin-top:18px; font-size:13px; color:var(--text-faint);
  display:flex; align-items:center; gap:8px;
}
.demo-link button{ background:none;border:none;color:var(--accent);font-weight:600;cursor:pointer;font-size:13px;padding:0; text-decoration:underline; text-decoration-color:transparent; transition:text-decoration-color .15s; }
.demo-link button:hover{ text-decoration-color:var(--accent); }

.local-deck-panel{
  width:100%; max-width:640px; margin-top:18px;
  background:var(--bg-elevated); border:1px solid var(--border-soft); border-radius:var(--radius-lg);
  padding:16px; text-align:left;
}
.local-deck-title{ font-size:12px; font-weight:700; color:var(--text-faint); margin-bottom:10px; letter-spacing:.06em; text-transform:uppercase; }
.local-deck-list{ display:flex; flex-direction:column; gap:8px; max-height:260px; overflow-y:auto; padding:3px 2px 2px; }
.local-deck-btn{
  display:flex; align-items:center; justify-content:space-between; gap:14px;
  width:100%; border:1px solid var(--border-soft); background:var(--bg-soft); color:var(--text);
  padding:11px 13px; border-radius:var(--radius-md); cursor:pointer; text-align:left;
  transition:background var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
}
.local-deck-btn:hover{ background:var(--bg-hover); border-color:var(--accent); transform:translateY(-1px); }
.local-deck-btn.active{ border-color:var(--accent); background:var(--accent-glow); box-shadow:inset 0 0 0 1px color-mix(in srgb, var(--accent) 45%, transparent); }
.local-deck-btn span{ min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:13px; font-weight:700; }
.local-deck-btn b{ flex-shrink:0; font-family:var(--font-num); font-style:italic; color:var(--accent); font-size:13px; }

.load-error{
  margin-top:16px; max-width:640px; width:100%;
  background:var(--danger-bg); border:1px solid color-mix(in srgb, var(--danger) 35%, transparent); color:var(--danger-strong);
  border-radius:var(--radius-md); padding:14px 16px; font-size:13px; line-height:1.7; text-align:left;
  white-space:pre-wrap;
}

/* ============================================================
   7. 设置 / 学习模式选择
   ============================================================ */
.deck-info-card{
  display:flex; align-items:center; gap:16px;
  padding:18px 20px; border-radius:var(--radius-lg);
  background:linear-gradient(155deg,var(--paper),var(--paper-alt));
  color:var(--ink); box-shadow:var(--shadow-pop); margin-bottom:26px;
}
.deck-info-card .deck-emoji{ font-size:30px; }
.deck-info-card > div{ min-width:0; }
.deck-info-card h2{ font-size:19px; color:var(--ink); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.deck-info-card p{ margin:4px 0 0; font-size:12.5px; color:var(--ink-soft); line-height:1.6; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
.deck-info-card .deck-actions{display:flex;align-items:center;justify-content:flex-end;gap:12px;margin-left:auto;flex:0 0 auto;}
