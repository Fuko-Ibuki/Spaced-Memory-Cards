.notes-document-filter-line{display:flex;align-items:center;gap:8px;flex:0 0 auto;white-space:nowrap;}
.notes-document-filter-line>span{color:var(--text-faint);font-size:12px;font-weight:700;}
.notes-filter-dropdown{position:relative;flex:0 0 auto;}
.notes-filter-dropdown>summary{height:36px;box-sizing:border-box;min-width:142px;max-width:220px;padding:0 12px;border:1px solid var(--border);border-radius:var(--radius-pill);background:var(--bg-soft);color:var(--text-soft);}
.notes-filter-dropdown>summary.active,.notes-filter-dropdown[open]>summary{border-color:var(--accent);background:var(--accent-glow);color:var(--text);}
.notes-filter-dropdown>summary .chev{margin-left:auto;transition:transform .16s ease;}
.notes-filter-dropdown[open]>summary .chev{transform:none;}
.notes-heading-actions .note-test-btn{flex:0 0 auto;min-height:36px;padding:0 16px;border-radius:var(--radius-pill);white-space:nowrap;}
.notes-heading-actions .chapter-clear-btn{height:36px;padding:0 12px;}
.notes-filter-menu{top:calc(100% + 10px);right:0;left:auto;width:300px;max-height:min(440px,calc(100vh - 150px));padding:10px;border-radius:16px;}
.notes-filter-menu-all{margin-bottom:8px;}
.notes-filter-menu strong{padding:9px 10px 4px;}
.notes-filter-check{min-height:34px;box-sizing:border-box;padding:7px 10px;border-radius:9px;font-size:12.5px;}
.notes-filter-check input{accent-color:var(--accent);}
@media (max-width:760px){
  .notes-document-heading{align-items:flex-start;gap:10px;}
  .notes-heading-actions{gap:8px;}
  .notes-document-filter-line>span{display:none;}
  .notes-filter-dropdown>summary{min-width:126px;}
}
@media (max-width:560px){
  .notes-document-heading{overflow-x:auto;scrollbar-width:none;}
  .notes-document-heading::-webkit-scrollbar{display:none;}
  .notes-heading-actions{margin-left:auto;}
}
/* Notes section sticky heading: a compact, solid bar directly below the global navigation. */
.note-section + .note-section{margin-top:72px;}
.note-section-heading{
  position:sticky;
  /* Position is measured from the floating controls so their centers stay aligned. */
  top:var(--notes-sticky-top, 0px);
  z-index:25;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:14px;
  min-height:52px;
  box-sizing:border-box;
  margin:0 0 12px;
  padding:0;
  background:var(--bg);
  border-bottom:1px solid var(--border-soft);
  box-shadow:none;
  backdrop-filter:none;
  -webkit-backdrop-filter:none;
}
/* Keep the floating directory control above the seamless fill layer. */
.notes-toc.collapsed{z-index:86;}
.note-section-heading::before{
  content:'';
  position:fixed;
  top:0;
  right:0;
  left:0;
  height:var(--notes-sticky-top, 0px);
  z-index:0;
  background:var(--bg);
  pointer-events:none;
}
.note-section-heading>div:first-child{
  position:relative;
  z-index:1;
  display:flex;
  flex:1 1 auto;
  min-width:0;
  height:52px;
  align-items:center;
  gap:14px;
}
.note-section-heading>div:first-child>h2{flex:0 0 auto;margin:0;}
.note-section-heading .note-section-description{
  min-width:0;
  margin:0;
  overflow:hidden;
  color:var(--text-faint);
  text-overflow:ellipsis;
  white-space:nowrap;
}
.note-section-tools{
  display:flex;
  flex:0 0 auto;
  align-self:stretch;
  align-items:center;
  justify-content:center;
  min-height:52px;
}
.note-section-tools .btn{box-sizing:border-box;margin:0;}
@media (max-width:760px){
  .note-section-heading{top:var(--notes-sticky-top, 0px);min-height:48px;}
  .note-section-heading>div:first-child,.note-section-tools{height:48px;min-height:48px;}
}
@media (max-width:640px){
  .note-section-heading{gap:10px;}
  .note-section-heading>div:first-child{gap:10px;}
  .note-section-heading .note-section-description{font-size:11px;}
  .note-section-tools{gap:7px;}
}
/* Mobile notes hierarchy: keep document title and test action in the flow below the fixed navigation. */
@media (max-width:640px){
  .notes-document{padding-top:12px;}
  .notes-document-heading{position:relative;z-index:30;display:flex;align-items:center;min-height:56px;margin:0 0 22px;padding:0 4px;overflow:visible;white-space:normal;}
  .notes-document-heading .notes-document-title{display:block;flex:1 1 auto;min-width:0;overflow:visible;text-overflow:clip;white-space:normal;font-size:26px;}
  .notes-heading-actions{display:flex;flex:0 0 auto;visibility:visible;opacity:1;overflow:visible;}
  .notes-heading-actions .note-test-btn{display:inline-flex;visibility:visible;flex:0 0 auto;min-height:40px;padding:0 14px;}
  .note-section:first-of-type{margin-top:12px;}
}
