}
.deck-switch-select{ display:none; width:100%; margin:-12px 0 24px; }
.deck-switch-select select{
  width:100%; border:1px solid var(--border); border-radius:var(--radius-pill);
  background:var(--bg-elevated); color:var(--text); padding:10px 14px; font-size:13px; font-weight:700;
}
.deck-switcher button{
  display:flex; align-items:center; gap:8px; border:1px solid var(--border-soft); background:var(--bg-elevated);
  color:var(--text-soft); border-radius:var(--radius-pill); padding:7px 12px; cursor:pointer; font-size:12.5px; font-weight:700;
  max-width:260px;
}
.deck-switcher span{ min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.deck-switcher button.active{ border-color:var(--accent); background:var(--accent-glow); color:var(--text); }
.deck-switcher b{ color:var(--accent); font-family:var(--font-num); font-style:italic; }

.mode-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin-bottom:28px; }
.mode-card{
  position:relative; text-align:left; cursor:pointer;
  border:1.5px solid var(--border); border-radius:var(--radius-lg);
  background:var(--bg-elevated); padding:18px 16px 16px;
  transition:border-color var(--dur) var(--ease), transform var(--dur) var(--ease), background var(--dur) var(--ease);
}
.mode-card:hover{ transform:translateY(-2px); border-color:var(--border); background:var(--bg-soft); }
.mode-card.selected{ border-color:var(--accent); background:linear-gradient(160deg,var(--accent-glow),transparent); box-shadow:0 0 0 1px var(--accent) inset; }
.mode-card .mode-icon{ font-size:22px; margin-bottom:10px; display:block; }
.mode-card h4{ font-size:15px; color:var(--text); margin-bottom:5px; }
.mode-card p{ margin:0; font-size:12px; color:var(--text-soft); line-height:1.6; min-height:48px; }
.mode-card .mode-tag{ display:inline-block; margin-top:10px; font-size:10.5px; padding:3px 8px; border-radius:var(--radius-pill); background:var(--bg-soft); color:var(--text-faint); font-weight:600; }
.mode-card.selected .mode-tag{ background:var(--accent); color:var(--accent-ink); }

.setup-grid{ display:grid; grid-template-columns:1fr 1fr; gap:16px; align-items:stretch; }
@media (max-width:720px){ .setup-grid{ grid-template-columns:1fr; } .mode-grid{ grid-template-columns:1fr; } }

.type-chip{
  display:inline-flex; align-items:center; gap:7px;
  padding:9px 14px; border-radius:var(--radius-pill);
  border:1.5px solid var(--border); background:var(--bg-soft); color:var(--text-soft);
  font-size:13px; font-weight:600; cursor:pointer; user-select:none;
  transition:all var(--dur-fast) var(--ease);
}
.type-chip .cnt{ font-family:var(--font-num); font-style:italic; opacity:.75; font-size:12px; }
.type-chip.on{ border-color:var(--accent); background:var(--accent-glow); color:var(--text); }
.type-chip.on .chip-check{ color:var(--accent); }
.chips-row{ display:flex; flex-wrap:wrap; gap:9px; }
.tf-filter-row{ display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px; margin-top:12px; padding-top:12px; border-top:1px dashed var(--border-soft); }
.tf-filter-label{ font-size:12px; color:var(--text-faint); }
.source-scope-row{ display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px; margin-bottom:14px; }
.chapter-filter-row{ margin-top:12px; padding-top:12px; border-top:1px dashed var(--border-soft); }
.chapter-chip-row{ display:flex; flex-wrap:wrap; gap:7px; margin-top:9px; max-height:112px; overflow:auto; padding-right:2px; }
.chapter-chip{
  border:1px solid var(--border-soft); background:var(--bg-soft); color:var(--text-soft); border-radius:var(--radius-pill);
  padding:6px 10px; font-size:12px; font-weight:700; cursor:pointer;
}
.chapter-chip.active{ background:var(--accent); border-color:var(--accent); color:var(--accent-ink); }

.toggle-row{ display:flex; align-items:center; justify-content:space-between; padding:13px 0; border-bottom:1px solid var(--border-soft); }
.toggle-row:last-child{ border-bottom:none; }
.toggle-row .label{ font-size:14px; color:var(--text); font-weight:600; }
.toggle-row .desc{ font-size:12px; color:var(--text-faint); margin-top:2px; }
.time-limit-options{ margin:0 0 12px; padding:10px 0 0; }
.time-limit-choice-row{ display:flex; align-items:center; flex-wrap:wrap; gap:16px; }
.time-limit-presets{ flex-wrap:nowrap; gap:0; }
.time-limit-presets button{ white-space:nowrap; padding:7px 11px; }
.time-limit-unit{ color:var(--text-soft); font-size:12.5px; white-space:nowrap; }
.time-limit-range-note{ margin-top:8px; color:var(--text-faint); font-size:12px; }
.switch{ position:relative; width:42px; height:24px; padding:0; border-radius:var(--radius-pill); background:var(--bg-soft); border:1px solid var(--border); cursor:pointer; flex-shrink:0; transition:background var(--dur) var(--ease); }
.switch.on{ background:var(--accent); border-color:var(--accent); }
.switch .knob{ position:absolute; top:2px; left:2px; width:18px; height:18px; border-radius:50%; background:var(--text); transition:transform var(--dur) var(--ease-spring), background var(--dur) var(--ease); }
.switch.on .knob{ transform:translateX(18px); background:var(--accent-ink); }

.qty-row{ display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
.seg{ display:flex; background:var(--bg-soft); border:1px solid var(--border); border-radius:var(--radius-pill); padding:3px; }
.seg button{ border:none; background:transparent; padding:7px 14px; border-radius:var(--radius-pill); font-size:12.5px; font-weight:600; color:var(--text-soft); cursor:pointer; }
.seg button.active{ background:var(--accent); color:var(--accent-ink); }
.num-input{
  width:76px; padding:8px 10px; border-radius:var(--radius-sm); border:1px solid var(--border);
  background:var(--bg-soft); color:var(--text); font-size:13px; text-align:center;
}

.collapsible-head{
  display:flex; align-items:center; gap:10px; cursor:pointer; user-select:none;
  padding:8px 6px; margin:-8px -6px; border-radius:var(--radius-sm);
  border:none; background:transparent; width:calc(100% + 2px); text-align:left; font-family:inherit;
  font-size:14.5px; font-weight:700; color:var(--text);
  transition:background var(--dur-fast) var(--ease);
}
.collapsible-head:hover{ background:var(--bg-soft); }
.collapsible-head .chev{ font-size:inherit; color:var(--text-faint); flex-shrink:0; line-height:1; transform:none; }
.collapsible-head.open .chev{ color:var(--accent); }
.collapsible-body{ overflow:hidden; max-height:0; transition:max-height var(--dur-slow) var(--ease); }
.collapsible-body.open{ max-height:600px; }
.adv-panel{ margin-top:16px; }
.mobile-collapse-head{
  display:flex; align-items:center; justify-content:space-between; width:100%;
  border:none; background:transparent; color:var(--text); padding:0; font-size:14px; font-weight:var(--font-weight-heavy); cursor:pointer;
}
.mobile-collapse-head .chev{ color:var(--text-faint); font-size:inherit; line-height:1; transform:none; }
.setup-panel .mobile-collapse-body{ display:none; margin-top:14px; }
.setup-panel.open .mobile-collapse-body{ display:block; }
.setup-panel.open .mobile-collapse-head .chev{ color:var(--accent); }
.setup-panel .mobile-collapse-body > .section-title:first-child{ display:none; }
.points-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:12px; margin-top:16px; }
.points-item{ display:flex; align-items:center; justify-content:space-between; gap:8px; background:var(--bg-soft); padding:10px 12px; border-radius:var(--radius-md); border:1px solid var(--border-soft); }
.points-item span{ font-size:12.5px; color:var(--text-soft); }
.mock-preview{ margin-top:12px; padding:13px 15px; background:var(--accent-glow); border:1px solid rgba(88,196,110,.3); border-radius:var(--radius-md); font-size:12.5px; color:var(--text-soft); line-height:1.7; }
.mock-preview b{ color:var(--accent-strong); font-family:var(--font-num); font-style:italic; }

.start-bar{ display:flex; align-items:center; justify-content:space-between; gap:16px; margin-top:28px; padding-top:22px; border-top:1px solid var(--border-soft); }
.start-bar .est{ font-size:12.5px; color:var(--text-faint); }
.start-bar .est b{ color:var(--text); font-family:var(--font-num); font-style:italic; font-size:15px; }

/* ============================================================
   8. 答题卡片流 (核心界面)
   ============================================================ */
.quiz-shell{ flex:1; display:flex; flex-direction:column; }
.quiz-topbar{ display:flex; align-items:center; gap:14px; padding:16px 22px 6px; }
.progress-track{ flex:1; height:6px; border-radius:var(--radius-pill); background:var(--bg-soft); overflow:hidden; }
.progress-fill{ height:100%; border-radius:var(--radius-pill); background:linear-gradient(90deg,var(--accent),var(--gold)); transition:width var(--dur-slow) var(--ease); }
.progress-label{ font-size:12.5px; color:var(--text-faint); white-space:nowrap; font-family:var(--font-num); font-style:italic; }
.quiz-timer{ min-width:52px; text-align:center; color:var(--text-soft); font-family:var(--font-num); font-size:14px; font-variant-numeric:tabular-nums; transition:opacity var(--dur-fast) var(--ease); }
.quiz-timer.is-hidden{ visibility:hidden; }
.quiz-timer .timer-colon{ display:inline-block; width:.32em; opacity:1; transition:opacity .12s linear; }
.quiz-timer .timer-colon.is-hidden{ opacity:0; }
.quiz-pause,.quiz-exit{ font-size:12.5px; }
.quiz-exit{ font-size:12.5px; }

.pause-overlay{
  position:fixed; inset:0; z-index:100;
  display:flex; align-items:center; justify-content:center;
  padding:24px;
  background:rgba(10,14,18,.38);
  backdrop-filter:blur(10px) saturate(.72);
  -webkit-backdrop-filter:blur(10px) saturate(.72);
  cursor:default;
}
.pause-panel{
  width:min(360px,100%); padding:34px 28px 30px; text-align:center;
  border:1px solid var(--border); border-radius:var(--radius-lg);
  background:color-mix(in srgb,var(--bg-elevated) 94%,transparent);
  box-shadow:var(--shadow-card); color:var(--text);
}
.pause-icon{ display:flex; justify-content:center; color:var(--accent); margin-bottom:12px; }
.pause-icon svg{ width:28px; height:28px; fill:currentColor; }
.pause-panel h2{ font-size:24px; }
.pause-panel p{ margin:10px 0 24px; color:var(--text-soft); font-size:13px; }
.pause-continue{ min-width:132px; }

.card-stage{
  flex:1; display:flex; align-items:center; justify-content:center;
  padding:22px 20px 40px; position:relative;
}
.card-stack{ position:relative; width:100%; max-width:600px; }
.card-stack::before, .card-stack::after{
  content:""; position:absolute; left:50%; right:0; border-radius:var(--radius-lg);
  background:var(--paper-alt); opacity:.55;
}
.card-stack::before{ top:-8px; width:94%; height:100%; transform:translateX(-50%) scale(.98); z-index:-1; opacity:.5;}
.card-stack::after{ top:-16px; width:88%; height:100%; transform:translateX(-50%) scale(.96); z-index:-2; opacity:.3;}

.qcard{
  position:relative; z-index:1;
  background:linear-gradient(165deg,var(--paper),var(--paper-alt) 130%);
  color:var(--ink);
  border-radius:var(--radius-lg);
  box-shadow:var(--shadow-card), var(--shadow-glow);
  padding:38px 34px 30px;
  min-height:320px;
  display:flex; flex-direction:column;
  animation:cardIn .4s var(--ease);
}
@keyframes cardIn{ from{ opacity:0; transform:translateY(5px) scale(.994); } to{ opacity:1; transform:none; } }
.qcard.no-enter{ animation:none; }
.qcard.leaving{ animation:cardOut .12s ease forwards !important; pointer-events:none; }
@keyframes cardOut{ from{ opacity:1; } to{ opacity:0; } }
.qcard.flipping{ animation:cardFlip .38s var(--ease); }
@keyframes cardFlip{ 0%{ transform:scale(1) rotateX(0); opacity:1; } 45%{ transform:scale(.98) rotateX(5deg); opacity:.75;} 100%{ transform:scale(1) rotateX(0); opacity:1; } }
.qcard.shake{ animation:cardShake .32s ease; }
@keyframes cardShake{ 0%,100%{transform:translateX(0)} 20%{transform:translateX(-7px)} 40%{transform:translateX(6px)} 60%{transform:translateX(-4px)} 80%{transform:translateX(3px)} }
.qcard.pulse-good{ box-shadow:var(--shadow-card), 0 0 0 3px var(--success); }
.qcard.pulse-bad{ box-shadow:var(--shadow-card), 0 0 0 3px var(--danger); }

.qcard-tools{ position:absolute; top:28px; right:34px; display:flex; align-items:center; gap:8px; z-index:2; }
.bookmark-btn{
  width:34px; height:34px; aspect-ratio:1; flex:0 0 34px; padding:0; border-radius:50%; border:1px solid var(--paper-line);
  background:var(--surface-lift-1); color:var(--ink-faint); cursor:pointer; font-size:20px; line-height:1;
  display:flex; align-items:center; justify-content:center; transition:all var(--dur-fast) var(--ease);
}
.bookmark-btn:hover{ transform:translateY(-1px); background:var(--surface-lift-2); color:var(--gold); border-color:var(--gold); }
.bookmark-btn.on{ background:var(--gold-bg); color:var(--gold); border-color:color-mix(in srgb, var(--gold) 60%, transparent); }
.wrong-chip{
  padding:5px 9px; border-radius:var(--radius-pill); background:var(--danger-bg); color:var(--danger-strong);
  font-size:11px; font-weight:800; border:1px solid color-mix(in srgb, var(--danger) 35%, transparent); white-space:nowrap;
}

.qcard-type{ font-size:11px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; color:var(--ink-faint); margin-bottom:16px; padding-right:118px; display:flex; align-items:center; gap:8px; overflow-wrap:anywhere; }
.qcard-type .dot{ width:5px;height:5px; flex:0 0 5px; aspect-ratio:1; border-radius:50%; background:currentColor; }
.qcard-question{ font-family:var(--font-content); font-size:var(--font-size-content-lg); line-height:1.65; color:var(--color-content-primary); font-weight:var(--font-weight-regular); font-synthesis:weight style; flex:0 0 auto; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; }
.qcard-question .blank{ display:inline-block; width:86px; height:1.05em; vertical-align:-4px; border-bottom:3px solid var(--ink-faint); border-radius:0; margin:0 2px; }
.inline-blank-choice{
  position:relative; display:inline-flex; align-items:center; justify-content:center; min-width:70px; min-height:1.45em; margin:0 4px; padding:0 10px 4px;
  border:none; border-radius:0; background:transparent; color:var(--ink-soft); box-sizing:border-box;
  appearance:none; -webkit-appearance:none; font-family:inherit; font-size:.88em; line-height:1.2; font-weight:800; cursor:pointer; vertical-align:baseline; transition:all .18s var(--ease);
}
.inline-blank-choice::after{ content:""; position:absolute; left:9px; right:9px; bottom:0; height:3px; background:var(--ink-faint); border-radius:0; }
.blank-line-only{ display:inline-block; width:82px; height:.8em; transform:translateY(-1px); }
.inline-blank-choice.filled{ color:var(--success-strong); background:transparent; box-shadow:none; animation:blankFill .18s var(--ease); }
.inline-blank-choice.filled::after,.inline-blank-choice.correct::after{ background:var(--success); }
.inline-blank-choice.correct{ color:var(--success-strong); background:transparent; }
.inline-blank-choice.wrong{ color:var(--danger-strong); background:transparent; }
.inline-blank-choice.wrong::after{ background:var(--danger); }
.inline-blank-choice.active{ border:1.5px solid var(--accent); border-radius:12px; background:var(--surface-lift-1); box-shadow:0 0 0 3px var(--accent-glow); animation:blankFocus .22s var(--ease); }
.inline-blank-choice.active::after{ display:none; }
@keyframes blankFocus{ from{ transform:translateX(-8px) scale(.96); } to{ transform:translateX(0) scale(1); } }
@keyframes blankFill{ from{ transform:scale(.96); } to{ transform:scale(1); } }
.per-blank-options{ margin-top:34px; }

.blank-wrap{ position:relative; display:inline-flex; align-items:center; width:max(112px, calc(var(--blank-chars, 6) * 1.05em + 24px)); max-width:100%; height:1.45em; vertical-align:middle; margin:0 2px; transition:width var(--dur-fast) var(--ease); }
.qcard-blank-input{
  border:none; background:transparent; width:100%; box-sizing:border-box;
  font-family:var(--font-content); font-size:1em; line-height:1.1; font-weight:var(--font-weight-bold); color:var(--ink); text-align:center;
  padding:0 4px 4px; outline:none;
}
.blank-underline{ position:absolute; left:2px; right:2px; bottom:.12em; height:3px; background:var(--ink-faint); border-radius:0; transition:background var(--dur-fast) var(--ease), border-radius var(--dur-fast) var(--ease); }
.qcard-blank-input:focus + .blank-underline{ background:var(--accent); border-radius:var(--radius-pill); }
.qcard-blank-input.correct + .blank-underline{ background:var(--success); border-radius:var(--radius-pill); }
.qcard-blank-input.wrong + .blank-underline{ background:var(--danger); border-radius:var(--radius-pill); }
.qcard-blank-input.correct{ color:var(--success-strong); }
.qcard-blank-input.wrong{ color:var(--danger-strong); }

.qcard-body{ margin-top:26px; flex:1; min-height:0; display:flex; flex-direction:column; }
.qcard-body.choice-mode-body{ margin-top:30px; }
.qcard-body.per-blank-body{ margin-top:30px; flex:0 0 auto; }
.qcard-hint{ margin-top:auto; padding-top:18px; text-align:center; font-size:12px; color:var(--ink-faint); }

.reveal-divider{ margin:20px 0 16px; border:none; border-top:1.5px dashed var(--paper-line); }
.reveal-answer{ font-family:var(--font-content); font-size:var(--font-size-content-md); line-height:1.85; color:var(--color-content-primary); font-weight:var(--font-weight-regular); font-synthesis:weight style; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; }
.reveal-answer b{ color:var(--success-strong); }
.reveal-label{ font-size:11px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-faint); margin-bottom:8px; }

/* 选择题 / 判断题 选项 */
.opt-list{ display:grid; grid-auto-rows:minmax(52px,1fr); align-items:stretch; gap:10px; margin-top:4px; }
.opt-list.opt-list-free{ display:flex; flex-direction:column; align-items:stretch; }
.opt-list:not(.opt-list-free) .opt-btn{ height:100%; }
.opt-btn{
  display:flex; align-items:flex-start; gap:12px; text-align:left; min-width:0;
  padding:13px 16px; border-radius:var(--radius-md);
  border:1.5px solid var(--paper-line); background:var(--surface-lift-1);
  color:var(--ink); font-size:15px; cursor:pointer;
  transition:all var(--dur-fast) var(--ease);
}
.opt-btn:hover{ border-color:var(--ink-faint); background:var(--surface-lift-2); }
.opt-btn .opt-key{
  width:24px;height:24px; border-radius:50%; background:var(--paper-alt); color:var(--ink-soft);
  display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:700; flex-shrink:0; margin-top:1px;
}
.opt-btn .opt-text{ display:block; min-width:0; overflow-wrap:anywhere; word-break:break-word; line-height:1.5; }
.opt-btn.selected{ border-color:var(--accent); background:var(--accent-glow); }
.opt-btn.selected .opt-key{ background:var(--accent); color:var(--accent-ink); }
.opt-btn.correct{ border-color:var(--success); background:var(--success-bg); }
.opt-btn.correct .opt-key{ background:var(--success); color:#fff; }
.opt-btn.wrong{ border-color:var(--danger); background:var(--danger-bg); }
.opt-btn.wrong .opt-key{ background:var(--danger); color:#fff; }
.opt-btn:disabled{ cursor:default; }
.opt-btn:disabled:hover{ transform:none; }

.tf-row{ display:flex; gap:12px; margin-top:6px; }
.blank-choice-row{ display:flex; align-items:center; gap:12px; margin-bottom:12px; flex-wrap:wrap; }
.blank-choice-label{ font-size:12.5px; font-weight:700; color:var(--ink-soft); flex-shrink:0; min-width:40px; }
.blank-choice-opts{ display:flex; flex-wrap:wrap; gap:8px; }
.mini-opt-btn{
  padding:8px 14px; border-radius:var(--radius-pill); border:1.5px solid var(--paper-line);
  background:var(--surface-lift-1); color:var(--ink); font-size:13px; cursor:pointer;
  transition:all var(--dur-fast) var(--ease);
}
.mini-opt-btn:hover{ border-color:var(--ink-faint); background:var(--surface-lift-2); }
.mini-opt-btn.selected{ border-color:var(--accent); background:var(--accent-glow); font-weight:700; }
.mini-opt-btn.correct{ border-color:var(--success); background:var(--success-bg); color:var(--success-strong); font-weight:700; }
.mini-opt-btn.wrong{ border-color:var(--danger); background:var(--danger-bg); color:var(--danger-strong); }
.mini-opt-btn:disabled{ cursor:default; }
.tf-btn{ flex:1; padding:22px 10px; border-radius:var(--radius-md); border:1.5px solid var(--paper-line); background:var(--surface-lift-1); font-size:17px; font-weight:600; color:var(--ink); cursor:pointer; transition:all var(--dur-fast) var(--ease); text-align:center; }
.tf-btn .kbd{ opacity:.4; margin-left:6px; }
.tf-btn:hover{ background:var(--surface-lift-2); }
.tf-btn.selected{ border-color:var(--accent); background:var(--accent-glow); }
.tf-btn.correct{ border-color:var(--success); background:var(--success-bg); color:var(--success-strong); }
.tf-btn.wrong{ border-color:var(--danger); background:var(--danger-bg); color:var(--danger-strong); }

.essay-input{
  width:100%; min-height:130px; resize:vertical;
  border:1.5px solid var(--paper-line); border-radius:var(--radius-md);
  background:var(--surface-lift-1); color:var(--ink);
  padding:14px 16px; font-size:14.5px; line-height:1.7; outline:none;
  font-family:var(--font-content); font-weight:var(--font-weight-regular); font-synthesis:weight style;
}
.essay-input:focus{ border-color:var(--accent); background:var(--surface-lift-2); }
.essay-input::placeholder{ color:var(--ink-faint); }
.your-answer-box{ background:var(--surface-lift-1); border:1px solid var(--paper-line); border-radius:var(--radius-md); padding:14px 16px; font-family:var(--font-content); font-size:var(--font-size-content-sm); font-weight:var(--font-weight-regular); font-synthesis:weight style; line-height:1.75; color:var(--color-content-secondary); white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; }
.your-answer-box.correct{ background:var(--success-bg); border-color:color-mix(in srgb, var(--success) 42%, transparent); color:var(--success-strong); font-weight:700; }
.your-answer-box.wrong{ background:var(--danger-bg); border-color:color-mix(in srgb, var(--danger) 32%, transparent); color:var(--danger-strong); }

/* 卡片底部操作区 */
.qcard-actions{ margin-top:24px; display:flex; gap:12px; justify-content:flex-end; flex-wrap:wrap; }
.qcard-actions.center{ justify-content:center; }
.qcard-actions .self-eval-btn{ margin-right:auto; }

.rate-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:10px; margin-top:22px; }
.rate-btn{
  display:flex; flex-direction:column; align-items:center; gap:5px;
  padding:13px 6px; border-radius:var(--radius-md); border:none; cursor:pointer;
  font-size:13px; font-weight:700; color:#fff;
  transition:transform var(--dur-fast) var(--ease), filter var(--dur-fast) var(--ease);
}
.rate-btn:hover{ filter:brightness(1.08); transform:translateY(-2px); }
.rate-btn:focus-visible{ outline:3px solid var(--rate-focus-ring, rgba(255,255,255,.95)); outline-offset:4px; box-shadow:0 0 0 8px var(--rate-focus-halo, color-mix(in srgb, currentColor 28%, transparent)), 0 5px 0 rgba(0,0,0,.24); position:relative; z-index:2; }
.rate-btn .kbd{ background:rgba(255,255,255,.25); opacity:1; }
.rate-btn .interval{ font-size:10.5px; font-weight:500; opacity:.85; font-family:var(--font-num); font-style:italic; }
.rate-again{ background:var(--danger); --rate-focus-halo:color-mix(in srgb, var(--danger) 55%, transparent); }
.rate-hard{ background:var(--gold); color:var(--gold-ink); --rate-focus-ring:var(--gold-ink); --rate-focus-halo:color-mix(in srgb, var(--gold) 60%, transparent); }
.rate-hard .kbd{ background:rgba(0,0,0,.15); }
.rate-good{ background:var(--info); --rate-focus-halo:color-mix(in srgb, var(--info) 55%, transparent); }
.rate-easy{ background:var(--success); --rate-focus-ring:var(--success-ink); --rate-focus-halo:color-mix(in srgb, var(--success) 55%, transparent); }
.rate-easy .kbd{ background:rgba(0,0,0,.15); }

.flip-hint{ display:flex; align-items:center; justify-content:center; gap:10px; margin-top:26px; color:var(--ink-faint); font-size:12.5px; }
.flip-hint .kbd{ background:var(--surface-lift-2); color:var(--ink-soft); opacity:1; padding:3px 8px; min-width:auto; font-size:11px; }

/* 反馈浮层 */
.feedback-flash{
  position:fixed; top:22%; left:50%; transform:translate(-50%,-10px) scale(.8);
  padding:10px 22px; border-radius:var(--radius-pill); font-weight:700; font-size:15px;
  display:flex; align-items:center; gap:8px; z-index:100; opacity:0; pointer-events:none;
  box-shadow:0 12px 30px -8px rgba(0,0,0,.4);
}
.feedback-flash.show{ animation:flashPop .8s var(--ease); }
.feedback-flash.good{ background:var(--success); color:#fff; }
.feedback-flash.bad{ background:var(--danger); color:#fff; }
@keyframes flashPop{
  0%{ opacity:0; transform:translate(-50%,-4px) scale(.75); }
  18%{ opacity:1; transform:translate(-50%,0) scale(1.04); }
  30%{ transform:translate(-50%,0) scale(1); }
  78%{ opacity:1; }
  100%{ opacity:0; transform:translate(-50%,-6px) scale(.96); }
}

/* ============================================================
   9. 主观题自评 (打分阶段)
   ============================================================ */
.grade-progress{ text-align:center; font-size:12.5px; color:var(--text-faint); margin-bottom:8px; }
.grading-note{ margin-top:14px; color:var(--ink-faint); font-size:11.5px; line-height:1.6; text-align:center; }
.self-grade-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:10px; margin-top:20px; }
.sg-btn{
  border:none; border-radius:var(--radius-md); padding:14px 8px; cursor:pointer;
  display:flex; flex-direction:column; align-items:center; gap:4px; color:#fff; font-weight:700;
  transition:transform var(--dur-fast) var(--ease), filter var(--dur-fast) var(--ease);
}
.sg-btn:hover{ transform:translateY(-2px); filter:brightness(1.08); }
.sg-btn.selected{ box-shadow:0 0 0 3px var(--paper), 0 0 0 7px color-mix(in srgb, var(--accent) 42%, transparent); transform:translateY(-2px); }
.sg-btn .pct{ font-size:11px; font-weight:600; opacity:.9; font-family:var(--font-num); font-style:italic; }
.sg-0{ background:var(--danger); }
.sg-50{ background:var(--gold); color:var(--gold-ink); }
.sg-50 .kbd{ background:rgba(0,0,0,.15); }
.sg-80{ background:var(--info); color:#fff; }
.sg-100{ background:var(--success); }

/* ============================================================
   10. 结果报告
   ============================================================ */
.report-hero{ text-align:center; padding:36px 20px 14px; }
.report-hero .score-big{ font-family:var(--font-num); font-style:italic; font-size:76px; line-height:1; color:var(--accent); font-weight:600; }
.report-hero .score-big small{ font-size:28px; opacity:.6; font-style:normal; }
.report-hero .score-label{ margin-top:6px; font-size:14px; color:var(--text-soft); }
.report-stat-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin:26px 0; }
@media (max-width:640px){ .report-stat-grid{ grid-template-columns:repeat(2,1fr); } }
.stat-card{ background:var(--bg-elevated); border:1px solid var(--border-soft); border-radius:var(--radius-md); padding:16px 14px; text-align:center; }
.stat-card .v{ font-family:var(--font-num); font-style:italic; font-size:24px; color:var(--text); }
.stat-card .l{ font-size:11.5px; color:var(--text-faint); margin-top:4px; }

